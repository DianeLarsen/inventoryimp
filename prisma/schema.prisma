// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model InventoryItem {
  id                String   @id @default(cuid())
  name              String
  brand             String?
  category          String?
  quantityAvailable String?   // ✅ Make sure this exists
  productSize       String?   // ✅ Make sure this exists
  unit              String?
  location          String?
  notes             String?
  lowThreshold      String?
  imageUrl          String?
  upc               String?
  ingredients       Json?
  nutrition         Json?
  decrementStep     String?
  quantityValue      Decimal? @db.Decimal(12, 3)
  lowThresholdValue  Decimal? @db.Decimal(12, 3)
  decrementStepValue Decimal? @db.Decimal(12, 3)
  expiresAt         DateTime? @db.Date
  addedAt           DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  purchaseHistory   PurchaseHistory[] 
}




model User {
  id             String          @id @default(cuid())
  inventoryItems InventoryItem[]
  aiReceiptUsage AiReceiptUsage[]
}

model PurchaseHistory {
  id          String   @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  cost        Float
  costCents   Int?
  quantity    Float
  purchasedAt DateTime @default(now())
}

model AiReceiptUsage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  periodStart DateTime
  parseCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, periodStart])
  @@index([userId])
}